<?xml version="1.0" encoding="utf-8"?>
<!-- NovaRedux's icon as adaptive layers, so every launcher (and the
     default-home chooser) can shape it and theme it: the grid of apps with one
     gone nova, on navy, and an alpha-only version for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/appIconBackground" />
    <foreground android:drawable="@drawable/ic_launcher_mark" />
    <monochrome android:drawable="@drawable/ic_launcher_mark_mono" />
</adaptive-icon>
