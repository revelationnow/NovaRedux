<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup and phone-to-phone transfer (Android 12 and up):
     the home screen, the settings and the automatic layout backups. What
     only this phone needs stays out: the recent searches, launch counts and
     recently opened apps (UsageStore), and the crash log. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <exclude domain="file" path="datastore/supernova_usage.preferences_pb" />
        <exclude domain="file" path="supernova_crash.log" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <exclude domain="file" path="datastore/supernova_usage.preferences_pb" />
        <exclude domain="file" path="supernova_crash.log" />
    </device-transfer>
</data-extraction-rules>
