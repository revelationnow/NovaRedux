<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup (up to Android 11): the home screen, the settings
     and the automatic layout backups. What only this phone needs stays out:
     the recent searches, launch counts and recently opened apps
     (UsageStore), and the crash log. data_extraction_rules.xml says the
     same for Android 12 and up. -->
<full-backup-content>
    <include domain="file" path="." />
    <exclude domain="file" path="datastore/novaredux_usage.preferences_pb" />
    <exclude domain="file" path="novaredux_crash.log" />
    <!-- Their names before 28 Nov 2026, should one be left (StoreFiles). -->
    <exclude domain="file" path="datastore/supernova_usage.preferences_pb" />
    <exclude domain="file" path="supernova_crash.log" />
</full-backup-content>
