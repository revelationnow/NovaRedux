<?xml version="1.0" encoding="utf-8"?>
<!-- NovaRedux Connect writes no files, so the one place named here is empty:
     nothing goes into a backup or to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
